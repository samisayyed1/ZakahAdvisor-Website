# ---------------------------------------------------------------------------
# Zakah Advisor — environment
# Copy to `.env.local` for development. Never commit real values.
# ---------------------------------------------------------------------------

# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph,
# the sitemap and robots.txt. Falls back to http://localhost:3000 when unset,
# so no false production canonical is ever hard-coded.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Donation checkout links — one hosted-checkout URL per monthly support tier.
#
# EXTERNAL DEPENDENCY: these come from the payment provider's dashboard
# (Stripe, Donorbox, Givebutter, LaunchGood or equivalent). No merchant account
# was supplied with this build, so all five are currently empty.
#
# Each value must be an absolute https: URL. `npm run verify:donations` fails
# if any is missing or invalid, and `npm run build:production` runs that check
# before building — a deployment cannot ship with a dead tier button.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DONATE_10_URL=
NEXT_PUBLIC_DONATE_25_URL=
NEXT_PUBLIC_DONATE_50_URL=
NEXT_PUBLIC_DONATE_100_URL=
NEXT_PUBLIC_DONATE_200_URL=
